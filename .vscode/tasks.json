        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Monitor Defragmentor Serial",
      "type": "shell",
      "command": "pio",
      "args": ["device", "monitor"],
      "options": {
        "cwd": "${workspaceFolder}/firmware/defragmentor"
      },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
