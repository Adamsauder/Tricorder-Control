		{
			"label": "Install Python Dependencies",
			"type": "shell",
			"command": "C:/Prop Control/Prop-Control/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"pip",
				"install",
				"-r",
				"server/requirements.txt"
			],
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Start Python Server",
			"type": "shell",
			"command": "C:/Prop Control/Prop-Control/.venv/Scripts/python.exe",
			"args": [
				"server/enhanced_server.py"
			],
			"group": "build",
			"isBackground": true,
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Install Web Dependencies",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"npm",
				"install"
			],
			"options": {
				"cwd": "${workspaceFolder}/web",
				"shell": {
					"executable": "cmd.exe",
					"args": [
						"/d",
						"/c"
